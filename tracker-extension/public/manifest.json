{
  "manifest_version": 3,
  "name": "Branta Tracker",
  "version": "0.7.0",
  "key": "",
  "description": "Branta Tracker keeps your Shift honest and effortless — one-click Check In, breaks and Check Out, live work time, punctuality and overtime, and privacy-first activity tracking for the Branta Tech team.",
  "minimum_chrome_version": "120",
  "permissions": [
    "sidePanel",
    "alarms",
    "storage",
    "idle",
    "offscreen",
    "identity",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Branta Tracker",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; style-src 'self'; font-src 'self'; img-src 'self' data: blob: https://console-cdn.brantatech.com; connect-src 'self' data: blob: https://vvkzkmvsbmfczauiyaoh.supabase.co https://d3f7ab4cbf9f6fd72a34e3c6c455f15f.r2.cloudflarestorage.com; base-uri 'none'; form-action 'none'"
  },
  "host_permissions": [
    "https://vvkzkmvsbmfczauiyaoh.supabase.co/*",
    "https://d3f7ab4cbf9f6fd72a34e3c6c455f15f.r2.cloudflarestorage.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "counters.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}